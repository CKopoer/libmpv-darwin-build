+MPV_EXPORT int bilisail_joc_probe_install(mpv_handle *ctx, void *opaque,
+    void (*callback)(void *, const unsigned char *, int, double, double))
+{
+    if (!ctx || ctx->mpctx->initialized || !callback)
+        return MPV_ERROR_INVALID_PARAMETER;
+    struct mpv_global *global = mp_client_get_global(ctx);
+    if (global->joc_probe)
+        return MPV_ERROR_INVALID_PARAMETER;
+    global->joc_probe_context = opaque;
+    global->joc_probe = callback;
+    return 0;
+}
